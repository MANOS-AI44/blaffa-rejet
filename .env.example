# Base de données PostgreSQL (fournie automatiquement par Railway)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Sécurité
SESSION_SECRET=changez-moi-en-une-longue-chaine-aleatoire
JWT_SECRET=changez-moi-en-une-autre-longue-chaine

# Compte administrateur initial (créé au premier démarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# URL de base managment.io
MANAGMENT_BASE_URL=https://managment.io

# Port (Railway le définit automatiquement)
PORT=3000
